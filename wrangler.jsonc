{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jm-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },

  // 这个文件只服务两件事：本地 npm run dev，以及坚持用 wrangler 部署的人。
  // 变量和密钥一律在 Cloudflare 后台配置，代码里都有默认值，仓库不需要再改。
  //
  // 注意：wrangler 配置文件是配置的权威源。用 wrangler deploy 会把后台手动加的
  // 自定义域名路由冲掉，所以本项目「部署一次之后就只在后台操作」。
  "r2_buckets": [
    { "binding": "CACHE", "bucket_name": "jm-bot-cache" }
  ]
}
